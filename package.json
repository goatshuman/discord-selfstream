
{
  "name": "selfstream",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HTTP health-check service",
  "engines": {
    "node": ">=22.4.0 <23"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:web": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@dank074/discord-video-stream": "6.0.0",
    "discord.js-selfbot-v13": "3.7.1",
    "dotenv": "17.4.2"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  }
}
